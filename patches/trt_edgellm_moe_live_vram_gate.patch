+    }
+    if (context.logitBiasPerSlot.size() < static_cast<size_t>(context.activeBatchSize))
+    {
+        context.logitBiasPerSlot.resize(static_cast<size_t>(context.activeBatchSize));
+    }
+
+    std::unordered_map<int32_t, float> snapshot;
+    float const alpha = gLiveMoeAlpha.load(std::memory_order_relaxed);
+    if (enabled && std::fabs(alpha) > 1e-6F)
+    {
+        std::lock_guard<std::mutex> lock(gLiveMoeMutex);
+        snapshot = gLiveMoeBiases;
+    }
