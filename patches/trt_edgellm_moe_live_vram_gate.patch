+@router.post("/v1/moe/live_gate")
+async def update_live_moe_vram_gate(request: Request):
+    """Hot-swappable mid-stream VRAM logit bias mailbox endpoint for LocalSleep-MoE."""
+    payload = await request.json()
+    enabled = bool(payload.get("enabled", True))
+    alpha = float(payload.get("alpha", 1.0))
+    raw_biases = payload.get("logit_bias") or {}
+    clean_biases = {}
+    for k, v in raw_biases.items():
+        try:
+            clean_biases[int(k)] = float(v)
+        except (ValueError, TypeError):
+            continue
+    from ..runtime.engine import _import_runtime
+    rt = _import_runtime()
+    if hasattr(rt, "set_live_moe_logit_bias"):
+        rt.set_live_moe_logit_bias(enabled, alpha, clean_biases)
+        state = rt.get_live_moe_logit_bias_state() if hasattr(rt, "get_live_moe_logit_bias_state") else {}
+        return JSONResponse({"status": "ok", "mode": "c++_vram_mailbox", "state": state})
+    return JSONResponse({"status": "fallback", "mode": "pybind_not_rebuilt_yet"}, status_code=200)
+
+
+@router.get("/v1/moe/live_gate")
+async def get_live_moe_vram_gate():
+    from ..runtime.engine import _import_runtime
+    rt = _import_runtime()
+    if hasattr(rt, "get_live_moe_logit_bias_state"):
+        return JSONResponse({"status": "ok", "state": rt.get_live_moe_logit_bias_state()})
+    return JSONResponse({"status": "fallback", "state": {"enabled": False, "alpha": 0.0, "version": 0, "num_entries": 0}})
