From 9634e23733d6795465c18f8fc589aeab4413f880 Mon Sep 17 00:00:00 2001
From: omegacd <omegacd@127.0.0.1>
Date: Mon, 19 Oct 2026 03:21:19 +0800
Subject: [PATCH] fix(runtime/streaming): flush held-back stopMatchBuffer on
 terminal chunks and prevent UTF-8 split abort in pybind streaming

---
 cpp/runtime/streaming.cpp              | 33 ++++++++++++++++++++++++++
 experimental/pybind/edgellm_pybind.cpp |  1 +
 experimental/server/runtime/engine.py  | 25 +++++++++++++++++--
 3 files changed, 57 insertions(+), 2 deletions(-)

diff --git a/cpp/runtime/streaming.cpp b/cpp/runtime/streaming.cpp
index fb4ecf3..a3f06a6 100644
--- a/cpp/runtime/streaming.cpp
+++ b/cpp/runtime/streaming.cpp
@@ -363,6 +363,39 @@ void emitChunks(DecodingInferenceContext& context, tokenizer::Tokenizer const& t
         }
 
         bool const isFinal = context.finishedStates[i] != 0;
+        if (isFinal)
+        {
+            // decodePerSlot() executes before updateFinishStates(), so a slot that
+            // transitions to finished (e.g. kEndId or kLength) on this iteration ran
+            // decodePerSlot() with isFinal == false and held back up to (maxStopLen - 1)
+            // bytes in s.stopMatchBuffer (or trailing incomplete UTF-8 in s.pendingBytes).
+            // Flush both before assembling the terminal chunk.
+            std::string tailFlush;
+            if (!s.pendingBytes.empty())
+            {
+                tailFlush = tokenizer::emitDeltaFlush(s);
+            }
+            auto const& slotStops = context.stopStringsPerSlot[i];
+            bool const stopActive = !slotStops.empty() && s.terminalReason != FinishReason::kCancelled
+                && s.terminalReason != FinishReason::kError;
+            if (stopActive)
+            {
+                s.stopMatchBuffer.append(tailFlush);
+                if (!s.stopMatchBuffer.empty())
+                {
+                    auto outcome = applyStopStringMatch(s.stopMatchBuffer, slotStops, s.maxStopLen, /*isFinal=*/true);
+                    s.pendingEmitText.append(outcome.emitted);
+                    if (outcome.stopMatched)
+                    {
+                        s.terminalReason = FinishReason::kStopWords;
+                    }
+                }
+            }
+            else if (!tailFlush.empty())
+            {
+                s.pendingEmitText.append(tailFlush);
+            }
+        }
         if (s.pendingEmitText.empty() && !isFinal)
         {
             continue;
diff --git a/experimental/pybind/edgellm_pybind.cpp b/experimental/pybind/edgellm_pybind.cpp
index d09b9a9..1261bd9 100644
--- a/experimental/pybind/edgellm_pybind.cpp
+++ b/experimental/pybind/edgellm_pybind.cpp
@@ -992,6 +992,7 @@ PYBIND11_MODULE(_edgellm_runtime, m)
         .def(py::init<>())
         .def_readonly("token_ids", &StreamChunk::tokenIds)
         .def_readonly("text", &StreamChunk::text)
+        .def_property_readonly("text_bytes", [](StreamChunk const& c) { return py::bytes(c.text); })
         .def_readonly("prompt_token_count", &StreamChunk::promptTokenCount)
         .def_readonly("finished", &StreamChunk::finished)
         .def_readonly("reason", &StreamChunk::reason)
diff --git a/experimental/server/runtime/engine.py b/experimental/server/runtime/engine.py
index ac77465..ab41cd8 100644
--- a/experimental/server/runtime/engine.py
+++ b/experimental/server/runtime/engine.py
@@ -34,6 +34,7 @@ Example::
     llm.serve(port=8000)
 """
 
+import codecs
 import importlib.util
 import json
 import logging
@@ -241,6 +242,7 @@ def _pump_channels(rt, run, text_channel, audio_channel, sem=None):
         worker.start()
 
         text_done = text_channel is None
+        utf8_dec = codecs.getincrementaldecoder("utf-8")(errors="replace")
         audio_done = False
         try:
             while not (text_done and audio_done):
@@ -254,8 +256,17 @@ def _pump_channels(rt, run, text_channel, audio_channel, sem=None):
                     if chunk is not None:
                         reason = finish_reason_name(
                             rt, chunk.reason) if chunk.finished else None
+                        try:
+                            raw_str = chunk.text
+                            if utf8_dec.getstate()[0]:
+                                safe_text = utf8_dec.decode(raw_str.encode("utf-8"), final=chunk.finished)
+                            else:
+                                safe_text = raw_str
+                        except UnicodeDecodeError as ude:
+                            raw_b = ude.object if isinstance(ude.object, bytes) else b""
+                            safe_text = utf8_dec.decode(raw_b, final=chunk.finished)
                         yield StreamDelta(
-                            text=chunk.text,
+                            text=safe_text,
                             token_ids=list(chunk.token_ids),
                             prompt_tokens=(chunk.prompt_token_count
                                            if chunk.prompt_token_count >= 0
@@ -1713,6 +1724,7 @@ class LLM:
                 worker.start()
 
             saw_finished = False
+            utf8_dec = codecs.getincrementaldecoder("utf-8")(errors="replace")
             try:
                 while True:
                     chunk = channel.wait_pop(timeout_ms=200)
@@ -1741,8 +1753,17 @@ class LLM:
                         # right after the terminal delta must not be taken for
                         # a disconnect and cancel a request that completed.
                         state["finished_cleanly"] = True
+                    try:
+                        raw_str = chunk.text
+                        if utf8_dec.getstate()[0]:
+                            safe_text = utf8_dec.decode(raw_str.encode("utf-8"), final=chunk.finished)
+                        else:
+                            safe_text = raw_str
+                    except UnicodeDecodeError as ude:
+                        raw_b = ude.object if isinstance(ude.object, bytes) else b""
+                        safe_text = utf8_dec.decode(raw_b, final=chunk.finished)
                     yield StreamDelta(
-                        text=chunk.text,
+                        text=safe_text,
                         token_ids=list(chunk.token_ids),
                         prompt_tokens=(chunk.prompt_token_count
                                        if chunk.prompt_token_count >= 0 else
